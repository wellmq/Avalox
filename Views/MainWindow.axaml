<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Avalox.ViewModels"
        xmlns:v="using:Avalox.Views"
        x:Class="Avalox.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Avalox">
  <!-- Шаблоны представлений для разных ViewModel -->
  <Window.DataTemplates>
    <!-- Шаблон для экрана регистрации/авторизации -->
    <DataTemplate DataType="{x:Type vm:RegAuthViewModel}">
      <v:RegAuthView/>
    </DataTemplate>
    <!-- Шаблон для основного чата -->
    <DataTemplate DataType="{x:Type vm:ChatViewModel}">
      <v:ChatView/>
    </DataTemplate>
  </Window.DataTemplates>

  <!-- Текущее представление, меняется в MainViewModel -->
  <ContentControl Content="{Binding CurrentViewModel}"/>
</Window>
