<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Avalox.ViewModels"
        xmlns:v="using:Avalox.Views"
        x:Class="Avalox.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalox.ico"
        Title="Avalox">
  <!-- View templates for different ViewModels -->
  <Window.DataTemplates>
    <!-- Template for registration/authorization view -->
    <DataTemplate DataType="{x:Type vm:RegAuthViewModel}">
      <v:RegAuthView/>
    </DataTemplate>
    <!-- Template for main chat view -->
    <DataTemplate DataType="{x:Type vm:ChatViewModel}">
      <v:ChatView/>
    </DataTemplate>
  </Window.DataTemplates>

  <!-- Current view bound to MainViewModel -->
  <ContentControl Content="{Binding CurrentViewModel}"/>
</Window>
